# Copy to .env.local and fill in. Never commit real values.

# Google reCAPTCHA v2 ("I'm not a robot" checkbox) for the /resume page.
# Create keys at https://www.google.com/recaptcha/admin (type: Challenge v2 > "I'm not a robot").
# Add your domains (e.g. benodeveloper.com and localhost) to the key's domain list.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Optional: secret used to sign the short-lived résumé links (any long random string,
# e.g. `openssl rand -base64 32`). Falls back to RECAPTCHA_SECRET_KEY when empty.
RESUME_LINK_SECRET=
